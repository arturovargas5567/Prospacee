<Window x:Class="Prospace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/Prospace.ico"
        Title="Prospace" Height="780" Width="1220" MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterScreen" Background="#F5F6FA">
    <Grid x:Name="RootLayout">
        <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="Sidebar" Grid.Column="0" Background="#20263B">
            <DockPanel Margin="22,26">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,36">
                    <TextBlock Text="✦  Prospace" Foreground="White" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="BY ARTURO VARGAS" Foreground="#AAB0C5" FontSize="10" FontWeight="Bold" Margin="3,8,0,0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Tus datos se guardan en este equipo." Foreground="#AAB0C5" FontSize="11" TextWrapping="Wrap" Margin="0,20,0,4" />
                <StackPanel x:Name="Navigation" />
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="42,32,42,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,28">
                <TextBlock x:Name="PageTitle" Text="Inicio" FontSize="30" FontWeight="Bold" Foreground="#20263B" />
                <TextBlock x:Name="PageSubtitle" Text="Un lugar para organizar tus estudios y tu día a día." FontSize="14" Foreground="#788198" Margin="0,5,0,0" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentHost" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

